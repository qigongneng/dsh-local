{
  "name": "dsh-host-history-lite",
  "version": "0.1.0",
  "description": "Host plugin for dsh web that slims session.history responses by folding finalized assistant/chunk deltas, reducing history payloads for long streaming sessions",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsdown",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "dsh",
    "plugin",
    "history",
    "session"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GithungDang/dsh-host-history-lite.git"
  },
  "bugs": {
    "url": "https://github.com/GithungDang/dsh-host-history-lite/issues"
  },
  "homepage": "https://github.com/GithungDang/dsh-host-history-lite"
}
